# Ollama Configuration
# URL du serveur Ollama (default: http://localhost:11434/api/generate)
# Sur un serveur distant, utilise l'IP du serveur:
# OLLAMA_URL=http://192.168.1.100:11434/api/generate
OLLAMA_URL=http://localhost:11434/api/generate

# Modèle Ollama à utiliser (default: mistral)
# Options: mistral, llama3, neural-chat, etc.
OLLAMA_MODEL=mistral

# API URL (optionnel)
NEXT_PUBLIC_API_URL=http://localhost:3000
